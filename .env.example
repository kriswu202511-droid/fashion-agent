# 后端
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/fashion_agent
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 千问 API
DASHSCOPE_API_KEY=your-dashscope-api-key

# 视频生成
VIDEO_MODE=pipeline
VIDEO_API_KEY=
VIDEO_API_URL=

# 应用
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS 配置
# 开发环境默认允许 localhost，生产环境应设置为实际域名
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
CORS_CREDENTIALS=true
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# 前端
VITE_API_BASE_URL=http://localhost:8000

# 阿里云 OSS（留空则使用本地存储）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=
OSS_CDN_DOMAIN=
